@model IEnumerable<pimFinal.Models.Produto>//aqui fala que recebe dados do models produto 
@{
    ViewData["Title"] = "Pediê";
}

<div class="text-center mb-5">
    <h1 class="display-4">Pediê</h1>
    <p id="subtitulo">Doces feitos com carinho.</p>
</div>

<div class="row">

    @foreach (var produto in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <img 
                    src="@produto.ImagemUrl"
                    alt="@produto.Nome"
                    class="card-img-top imagem-produto">

                    <h5 class="card-title">
                        <p>@produto.Nome</p>
                    </h5>

                    <p class="card-text">
                        @produto.Descricao
                    </p>

                    <p>
                        <strong>Preço:</strong>
                        R$ @produto.Preco
                    </p>

                    <p>
                        <strong>Disponível</strong>
                        @(produto.Disponivel ? "Sim" : "Não")
                    </p>
                </div>
            </div>
        </div>

    }