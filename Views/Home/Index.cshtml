@model IEnumerable<pimFinal.Models.Produto>//aqui fala que recebe dados do models produto 
@{
    ViewData["Title"] = "Pediê";
}

<div class="text-center mb-5">
    <h1 class="display-4">Pediê</h1>
    <p id="subtitulo">Doces feitos com carinho.</p>
</div>

<div class="row">

    @foreach (var produto in Model)
    {
        <div class="col-6 col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        <p class="nomeProduto">@produto.Nome</p>
                    </h5>
                    <div class="text-center">

                        <img 
                        src="@produto.ImagemUrl"
                        alt="@produto.Nome"
                        class="imagem-produto">
                    </div>


                    

                    <p class="preco">
                        
                        R$ @produto.Preco
                    </p>

                    <form asp-controller="Carrinho"
                        asp-action="Adicionar"
                        method="post">

                        <input type="hidden"
                            name="id"
                            value="@produto.IdProduto" />

                            <button type="submit"
                                    class="btn w-100">
                                Adicionar ao Carrinho
                            </button>

                    </form>

                    
                </div>
            </div>
        </div>

    }