@model List<pimFinal.Models.ItemCarrinho>

@{
    ViewData["Title"] = "Carrinho";
}

<h1 class="tituloCarrinho mb-4">Carrinho</h1>

@if (!Model.Any())
{
    <div class="card shadow-sm text-center p-5">
        <div class="card-body">
            <div class="display-4 text-muted mb-3 bi bi-cart-x"></div>
            <h4 class="tituloCarrinho mb-3">Seu carrinho está vazio.</h4>
            <p class="text-muted mb-4">Que tal escolher alguns doces deliciosos no nosso catálogo?</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                Ver Catálogo de Doces
            </a>
        </div>
    </div>
}
else
{
    decimal total = 0;

    foreach (var item in Model)
    {
        if (item.Produto == null) continue;
        var subtotal = item.Produto.Preco * item.Quantidade;
        total += subtotal;

        <div class="card mb-3 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="imagem-carrinho">
                    <img class="imagem-produto rounded" src="@item.Produto.ImagemUrl" alt="@item.Produto.Nome" />
                </div>

                <div class="letrasCarrinho flex-grow-1">
                    <h4 class="letrasCarrinho">@item.Produto.Nome</h4>
                    <p class="letrasCarrinho mb-1">
                        Preço Unitário: R$ @item.Produto.Preco.ToString("N2")
                    </p>
                    <p class="letrasCarrinho fw-bold mb-0">
                        Subtotal: R$ @subtotal.ToString("N2")
                    </p>
                </div>

                <div class="acoesCarrinho d-flex flex-column align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Carrinho"
                           asp-action="Diminuir"
                           asp-route-id="@item.Produto.IdProduto"
                           class="btn btn-outline-secondary btn-sm px-3 fw-bold">
                            -
                        </a>

                        <span class="qtdItens fw-bold px-2">@item.Quantidade</span>

                        <a asp-controller="Carrinho"
                           asp-action="Aumentar"
                           asp-route-id="@item.Produto.IdProduto"
                           class="btn btn-outline-secondary btn-sm px-3 fw-bold">
                            +
                        </a>
                    </div>

                    <a asp-controller="Carrinho"
                       asp-action="Remover"
                       asp-route-id="@item.Produto.IdProduto"
                       class="btn btn-danger btn-sm btn-remover">
                        <i class="bi bi-trash"></i> Remover
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm mt-4">
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <h3 class="mb-0">
                Total da Compra:
                <span class="text-success fw-bold">R$ @total.ToString("N2")</span>
            </h3>

            <div class="d-flex gap-2 flex-wrap justify-content-center">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg">
                    Continuar Comprando
                </a>
                <a asp-controller="Pedido"
                   asp-action="ChecarPedido"
                   class="btn btn-success btn-lg btn-finalizar fw-bold">
                    Confirmar Pedido <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}
