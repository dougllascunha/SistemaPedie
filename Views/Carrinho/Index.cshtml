
@model List<pimFinal.Models.ItemCarrinho>

@{
    ViewData["Title"] = "Carrinho";
}

<h1 class="tituloCarrinho"> Carrinho</h1>

@if (!Model.Any())
{
    <p class="tituloCarrinho">Seu carrinho está vazio.</p>
}
else
{
    decimal total = 0;
    
     foreach(var item in Model)
    {
        var subtotal = item.Produto.Preco * item.Quantidade;

        total += subtotal;

        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center ">
                <div class="imagem-carrinho">

                    <img class = "imagem-produto "src="@item.Produto.ImagemUrl"
                            alt="@item.Produto.Nome"/>

                </div>

                <div class="letrasCarrinho">
                    <h4 class="letrasCarrinho">@item.Produto.Nome</h4>
                        <p class="letrasCarrinho">
                                Preço Unitário:
                                R$ @item.Produto.Preco.ToString("N2")
                        </p>

                        <p class="letrasCarrinho">
                                Subtotal:
                                R$ @subtotal.ToString("N2")
                        </p>
                </div>

                    

                    <div class="acoesCarrinho d-flex flex-column align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2 ">

                        <a asp-controller="Carrinho"

                            asp-action="Diminuir"
                            asp-route-id="@item.Produto!.IdProduto"
                            class="btn btn-sm">
                                -
                        </a>

                        <span class="qtdItens">@item.Quantidade</span>

                        <a asp-controller="Carrinho"

                            asp-action="Aumentar"
                            asp-route-id="@item.Produto!.IdProduto"
                            class="btn btn-sm">
                                +
                        </a>
                        </div>
                    
                        <a asp-controller="Carrinho"

                            asp-action="Remover"
                            asp-route-id="@item.Produto!.IdProduto"
                            class="btn btn-danger btn-remover">
                                Remover
                        </a>
                    </div>
                    

            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">

            <h3>
                Total da Compra:
                R$ @total.ToString("N2")
            </h3>

            <a asp-controller="Pedido"
                asp-action="Checkout"
                    class="btn btn-success btn-finalizar">
                    Finalizar Compra
            </a>

        </div>
    </div>
}