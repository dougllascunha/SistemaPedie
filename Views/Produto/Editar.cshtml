@model pimFinal.Models.Produto
@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Editar: @Model.Nome</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        
                        <!-- Campo oculto obrigatório para o Entity Framework saber qual produto atualizar -->
                        <input type="hidden" asp-for="IdProduto" />

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome do Doce</label>
                            <input asp-for="Nome" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label">Descrição</label>
                            <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Preco" class="form-label">Preço (R$)</label>
                                <!-- Substitui vírgula por ponto para não quebrar a formatação no HTML -->
                                <input asp-for="Preco" type="number" step="0.01" class="form-control" value="@Model.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IdCategoria" class="form-label">Categoria</label>
                                <select asp-for="IdCategoria" class="form-select">
                                    @foreach (var cat in ViewBag.Categorias)
                                    {
                                        if (cat.IdCategoria == Model.IdCategoria)
                                        {
                                            <option value="@cat.IdCategoria" selected>@cat.Nome</option>
                                        }
                                        else
                                        {
                                            <option value="@cat.IdCategoria">@cat.Nome</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImagemUrl" class="form-label">URL da Imagem</label>
                            <input asp-for="ImagemUrl" class="form-control" />
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="Disponivel" value="true">
                            <label class="form-check-label" asp-for="Disponivel">Produto Disponível para Venda</label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Atualizar Produto</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
