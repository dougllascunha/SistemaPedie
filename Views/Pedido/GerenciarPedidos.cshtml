@model IEnumerable<pimFinal.Models.Pedido>

@{
    ViewData["Title"] = "Gestão de Pedidos (Admin)";
}

<div class="container mt-4" id="containerGerenciarPedidos">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="text-danger fw-bold mb-0"><i class="bi bi-gear-fill me-2"></i>Painel de Controle de Pedidos</h2>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="d-flex align-items-center gap-2 small text-muted bg-white px-3 py-1 rounded-pill shadow-sm border">
                <span id="indicadorSyncAdmin" class="d-inline-block rounded-circle bg-success" style="width: 9px; height: 9px;"></span>
                <span id="textoSyncAdmin">Sincronização ativa</span>
            </div>
            <span class="badge bg-secondary fs-6" id="contadorTotalPedidosAdmin">@Model.Count() pedido(s)</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm">Nenhum pedido foi realizado no site ainda.</div>
    }
    else
    {
        <div class="row g-3" id="tabelaGerenciarPedidosBody">
            @foreach (var pedido in Model)
            {
                var badgeClass = pedido.IdSituacao switch
                {
                    1 => "bg-warning text-dark",
                    2 => "bg-info text-dark",
                    3 => "bg-primary",
                    4 => "bg-success",
                    5 => "bg-primary",
                    6 => "bg-danger",
                    _ => "bg-secondary"
                };

                <div class="col-12 col-lg-6" data-pedido-id="@pedido.IdPedido" data-situacao-id="@pedido.IdSituacao">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-3 p-sm-4 d-flex flex-column justify-content-between gap-3">
                            
                            <!-- Topo do Card: Número do Pedido, Cliente e Status Atual -->
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 border-bottom pb-3">
                                <div>
                                    <span class="fs-5 fw-bold text-dark me-2">#@pedido.IdPedido</span>
                                    <div class="fw-semibold text-secondary mt-1">
                                        <i class="bi bi-person-fill me-1"></i>@(pedido.Cliente?.Nome ?? "Cliente")
                                        @if (!string.IsNullOrWhiteSpace(pedido.Cliente?.NomeSocial))
                                        {
                                            <small class="text-muted">(@pedido.Cliente.NomeSocial)</small>
                                        }
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @badgeClass px-3 py-2 rounded-pill badge-status-admin" style="font-size: 0.85rem;">
                                        @(pedido.Situacao?.Descricao ?? "Indefinido")
                                    </span>
                                </div>
                            </div>

                            <!-- Meio do Card: Data e Valor Total -->
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div>
                                    <span class="text-muted small me-1">Total:</span>
                                    <span class="text-success fw-bold fs-5">R$ @pedido.valorTotal.ToString("N2")</span>
                                </div>
                            </div>

                            <!-- Rodapé do Card: Alterar Status e Salvar -->
                            <div class="bg-light p-2 rounded-3">
                                <form asp-controller="Pedido" asp-action="AtualizarStatus" method="post" class="d-flex align-items-center gap-2 flex-wrap flex-sm-nowrap form-atualizar-status-pedido">
                                    <input type="hidden" name="idPedido" value="@pedido.IdPedido" />

                                    <select name="idSituacao" class="form-select form-select-sm select-status-pedido flex-grow-1">
                                        @foreach (var sit in ViewBag.Situacoes)
                                        {
                                            if (sit.IdSituacao == pedido.IdSituacao)
                                            {
                                                <option value="@sit.IdSituacao" selected>@sit.Descricao</option>
                                            }
                                            else
                                            {
                                                <option value="@sit.IdSituacao">@sit.Descricao</option>
                                            }
                                        }
                                    </select>

                                    <button type="submit" class="btn btn-sm btn-primary text-nowrap px-3 w-100 w-sm-auto btn-salvar-status" style="max-width: 120px;">
                                        <i class="bi bi-check2 me-1"></i>Salvar
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
