@{
    ViewData["Title"] = "Pagamento Confirmado";
}

<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-success rounded-4">
                <div class="card-body p-5">
                    <div class="display-1 text-success mb-3 bi bi-check-circle-fill"></div>
                    <h2 class="text-success fw-bold">Pagamento Aprovado!</h2>
                    <p class="fs-5 text-muted mt-3">Recebemos o seu PIX. Seu pedido já foi enviado para a nossa cozinha e está sendo preparado com muito carinho.</p>
                    
                    <div class="alert alert-warning mt-4 p-4 rounded-3 shadow-sm border-warning">
                        <div class="fs-1 mb-2 bi bi-hourglass-split"></div>
                        <h5>Tempo Estimado de Preparo e Entrega:</h5>
                        <strong class="fs-3 text-dark">1h a 3h30 minutos</strong>
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Pedido" asp-action="MeusPedidos" class="btn btn-success btn-lg w-100 mb-3 rounded-pill fw-bold">Acompanhar meu Pedido</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill">Voltar ao Início</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
