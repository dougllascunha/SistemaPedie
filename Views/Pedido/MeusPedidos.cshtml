@model IEnumerable<pimFinal.Models.Pedido>

@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container mt-5">
    <h2 class="mb-4">Meus Pedidos</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Você ainda não realizou nenhum pedido. 
            <a asp-controller="Home" asp-action="Index" class="alert-link">Clique aqui para ver nossos doces!</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-hover table-bordered align-middle bg-white">
                <thead class="table-light">
                    <tr>
                        <th>Nº do Pedido</th>
                        <th>Data da Compra</th>
                        <th>Status</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@pedido.IdPedido</td>
                            <td>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            
                            <!-- Colocamos um badge colorido dependendo do status usando Bootstrap -->
                            <td>
                                <span class="badge @(pedido.IdSituacao == 1 ? "bg-warning text-dark" : 
                                                    pedido.IdSituacao == 4 ? "bg-success" : "bg-primary")">
                                    @pedido.Situacao.Descricao
                                </span>
                            </td>
                            
                            <td class="text-success fw-bold">R$ @pedido.valorTotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
