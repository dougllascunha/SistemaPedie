@model IEnumerable<pimFinal.Models.Pedido>

@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container mt-4" id="containerMeusPedidos">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h2 class="mb-0 fw-bold"><i class="bi bi-bag-check me-2 text-primary"></i>Meus Pedidos</h2>
        <div class="d-flex align-items-center gap-2 small text-muted bg-white px-3 py-1 rounded-pill shadow-sm border">
            <span id="indicadorSyncCliente" class="d-inline-block rounded-circle bg-success" style="width: 9px; height: 9px;" title="Sincronização automática ativa"></span>
            <span id="textoSyncCliente">Sincronização automática ativa</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center shadow-sm p-4 rounded-4">
            Você ainda não realizou nenhum pedido.
            <a asp-controller="Home" asp-action="Index" class="alert-link fw-bold ms-1">Clique aqui para ver nossos doces!</a>
        </div>
    }
    else
    {
        <div class="row g-3" id="tabelaMeusPedidosBody">
            @foreach (var pedido in Model)
            {
                var badgeClass = pedido.IdSituacao switch
                {
                    1 => "bg-warning text-dark",
                    2 => "bg-info text-dark",
                    3 => "bg-primary",
                    4 => "bg-success",
                    5 => "bg-primary",
                    6 => "bg-danger",
                    _ => "bg-secondary"
                };

                <div class="col-12 col-md-6" data-pedido-id="@pedido.IdPedido" data-situacao-id="@pedido.IdSituacao">
                    <div class="card border-0 shadow-sm rounded-4 h-100 card-pedido-cliente">
                        <div class="card-body p-3 p-sm-4 d-flex flex-column justify-content-between gap-3">
                            
                            <!-- Topo do Card: Número do Pedido + Status -->
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 border-bottom pb-3">
                                <div>
                                    <span class="text-muted small d-block">Nº do Pedido</span>
                                    <span class="fs-5 fw-bold text-dark">#@pedido.IdPedido</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge @badgeClass px-3 py-2 rounded-pill badge-status-pedido" style="font-size: 0.85rem;">
                                        @(pedido.Situacao?.Descricao ?? "Em processamento")
                                    </span>
                                </div>
                            </div>

                            <!-- Meio do Card: Detalhe de acompanhamento do Status -->
                            <div class="detalhe-status-pedido bg-light rounded-3 p-2 px-3">
                                @if (pedido.IdSituacao == 1 || pedido.IdSituacao == 2)
                                {
                                    <div class="text-muted fw-semibold bi bi-hourglass-split" style="font-size: 0.9rem;">
                                         Previsão: 1h a 3h30 min
                                    </div>
                                }
                                else if (pedido.IdSituacao == 5)
                                {
                                    <div class="text-primary fw-semibold bi bi-scooter" style="font-size: 0.9rem;">
                                         Seu pedido saiu para entrega!
                                    </div>
                                }
                                else if (pedido.IdSituacao == 3)
                                {
                                    <div class="text-primary fw-semibold bi bi-shop" style="font-size: 0.9rem;">
                                         Pronto! Disponível para retirada na loja.
                                    </div>
                                }
                                else if (pedido.IdSituacao == 4)
                                {
                                    <div class="text-success fw-semibold bi bi-check-circle-fill" style="font-size: 0.9rem;">
                                         Pedido entregue
                                    </div>
                                }
                                else if (pedido.IdSituacao == 6)
                                {
                                    <div class="text-danger fw-semibold bi bi-x-circle-fill" style="font-size: 0.9rem;">
                                         Pedido cancelado
                                    </div>
                                }
                            </div>

                            <!-- Rodapé do Card: Data da Compra e Valor Total -->
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-1">
                                <div class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    <span>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="text-end">
                                    <span class="text-muted small d-block" style="line-height: 1;">Total</span>
                                    <span class="text-success fw-bold fs-5 valor-total-pedido">R$ @pedido.valorTotal.ToString("N2")</span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
