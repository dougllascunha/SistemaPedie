@model pimFinal.Models.Cliente

@{
    ViewData["Title"] = "Criar Conta";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Registe a sua Conta</h2>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger text-center">
                            @ViewBag.Erro
                        </div>
                    }

                    <form asp-controller="Cliente" asp-action="Cadastrar" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        
                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label">Nome Completo</label>
                            <input asp-for="Nome" class="form-control" placeholder="Digite o seu nome" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NomeSocial" class="form-label">Nome Social (Opcional)</label>
                            <input asp-for="NomeSocial" class="form-control" placeholder="Como você prefere ser chamado(a)?" />
                            <div class="form-text">Se preenchido, usaremos este nome para falar com você.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-mail</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="exemplo@email.com" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Telefone" class="form-label">Telefone (Opcional)</label>
                            <input asp-for="Telefone" class="form-control" placeholder="(00) 00000-0000" />
                        </div>

                        <!-- Campo de senha adicionado e mapeado para SenhaAcesso -->
                        <div class="mb-3">
                            <label asp-for="SenhaAcesso" class="form-label">Senha</label>
                            <input asp-for="SenhaAcesso" type="password" class="form-control" placeholder="Crie uma senha segura" required minlength="6" />
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Finalizar Registro</button>
                            <a asp-controller="Cliente" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-outline-secondary">Voltar para o Login</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
