@{
    ViewData["Title"] = "Recuperar Senha";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Recuperar Senha</h2>
                    <p class="text-muted text-center mb-4">Confirme seus dados cadastrados para criar uma nova senha.</p>

                    @if (ViewBag.Erro != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Erro</div>
                    }

                    <form asp-controller="Cliente" asp-action="RecuperarSenha" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail Cadastrado</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>

                        <div class="mb-4">
                            <label for="telefone" class="form-label">Telefone Cadastrado</label>
                            <input type="text" name="telefone" class="form-control" placeholder="(DD) 9XXXX-XXXX" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">Validar Dados</button>
                            <a asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
