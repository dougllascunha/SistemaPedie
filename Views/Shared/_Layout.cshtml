<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta name="theme-color" content="#f790c9" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pediê</title>
    
    <link rel="icon" type="image/png" href="~/imagens/LogoPedie.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        @@media (max-width: 991px) {
            body { padding-bottom: 80px; }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar bg-white shadow-sm border-bottom">
            <div class="container d-flex justify-content-between align-items-center">

                <a class="navbar-brand mx-auto mx-lg-0" asp-controller="Home" asp-action="Index">
                    <img src="~/imagens/LogoPedie.png" alt="Pediê" class="logo-navbar fotologo" style="max-height: 60px;">
                </a>

                <div class="d-none d-lg-flex align-items-center">
                    <a class="nav-link mx-2" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="nav-link mx-2" asp-controller="Home" asp-action="Promocoes">Promoções</a>
                    <a class="nav-link mx-2 bi bi-cart3" asp-controller="Carrinho" asp-action="Index">Carrinho</a>
                    
                    @if (Context.Session.GetInt32("IdCliente") != null)
                    {
                        <a class="nav-link mx-2" asp-controller="Pedido" asp-action="MeusPedidos">Meus Pedidos</a>

                        @if (Context.Session.GetString("Perfil") == "Admin")
                        {
                            <a class="nav-link fw-bold text-danger mx-2 bi bi-gear" asp-controller="Pedido" asp-action="GerenciarPedidos"> Gestão de Pedidos</a>
                            <a class="nav-link fw-bold text-danger mx-2 bi bi-gear" asp-controller="Produto" asp-action="Index"> Gestão de Produtos</a>
                            <a class="nav-link fw-bold text-danger mx-2 bi bi-tags" asp-controller="Promocao" asp-action="Index"> Promoções</a>
                            <li><a class="dropdown-item fw-bold text-danger bi bi-tags" asp-controller="Promocao" asp-action="Index"> Gestão de Promoções</a></li>
                        }

                        <div class="ms-4 border-start ps-4">
                            <a class="btn btn-outline-danger bi bi-box-arrow-left" asp-controller="Cliente" asp-action="Sair"> Sair</a>
                        </div>
                    }
                    else
                    {
                        <div class="ms-4 border-start ps-4">
                            <a class="btn btn-primary" asp-controller="Cliente" asp-action="Login">Entrar / Criar Conta</a>
                        </div>
                    }
                </div>

            </div>
        </nav>
    </header>

    <nav class="navbar fixed-bottom bg-white border-top shadow-lg d-flex d-lg-none justify-content-around py-2" style="z-index: 1050;">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark text-center">
            <div class="fs-4 bi bi-house-door"></div>
            <small>Início</small>
        </a>
        <a asp-controller="Carrinho" asp-action="Index" class="text-decoration-none text-dark text-center">
            <div class="fs-4 bi bi-cart3"></div>
            <small>Carrinho</small>
        </a>
        
        @if (Context.Session.GetInt32("IdCliente") != null)
        {
            <a asp-controller="Pedido" asp-action="MeusPedidos" class="text-decoration-none text-dark text-center">
                <div class="fs-4 bi bi-bag"></div>
                <small>Pedidos</small>
            </a>
            
            if (Context.Session.GetString("Perfil") == "Admin")
            {
                <!-- MENU DROPUP DO ADMIN COM ÍCONES -->
                <div class="dropup text-center">
                    <a href="#" class="text-decoration-none text-danger fw-bold" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="fs-4 bi bi-gear"></div>
                        <small>Admin</small>
                    </a>
                    <ul class="dropdown-menu mb-2 shadow border-danger">
                        <li><a class="dropdown-item fw-bold text-danger bi bi-bag" asp-controller="Pedido" asp-action="GerenciarPedidos"> Gestão de Pedidos</a></li>
                        <li><a class="dropdown-item fw-bold text-danger bi bi-gear" asp-controller="Produto" asp-action="Index"> Gestão de Produtos</a></li>
                    </ul>
                </div>
            }

            <a asp-controller="Cliente" asp-action="Sair" class="text-decoration-none text-danger text-center">
                <div class="fs-4 box-arrow-left bi bi-box-arrow-left"></div>
                <small>Sair</small>
            </a>
        }
        else
        {
            <a asp-controller="Cliente" asp-action="Login" class="text-decoration-none text-dark text-center">
                <div class="fs-4 bi bi-person"></div>
                <small>Entrar</small>
            </a>
        }
    </nav>

    <main class="container mt-4 pb-5">
        @RenderBody()
    </main>

    <footer class="text-center mt-5 mb-4 d-none d-lg-block">
        <div class="container">
            <p class="text-muted mb-2" style="font-size: 0.85rem;">
                A Pediê valoriza a diversidade e não tolera qualquer forma de discriminação por raça, etnia, religião, gênero, orientação sexual ou condição social.
            </p>
            <p class="corfooter fw-bold"><small>© 2026 - Douglas Heinrick de Souza Cunha - Thiago Elson Alves Matos</small></p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
    if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
            navigator.serviceWorker.register("/service-worker.js")
                .catch(error => console.error(
                    "Falha ao registrar o service worker:",
                    error
                ));
        });
    }
    </script>

    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>
</body>
</html>
