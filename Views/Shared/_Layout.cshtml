<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pediê</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        @@media (max-width: 991px) {
            body { padding-bottom: 80px; }
        }
    </style>
</head>

<body class="bg-light">

    <!-- MENU TOPO (Desktop e Logo do Mobile) -->
    <header>
        <nav class="navbar navbar-expand-lg bg-white shadow-sm">
            <div class="container d-flex justify-content-between align-items-center">

                <!-- Logo -->
                <a class="navbar-brand mx-auto mx-lg-0" asp-controller="Home" asp-action="Index">
                    <img src="~/imagens/LogoPedie.png" alt="Pediê" class="logo-navbar fotologo" style="max-height: 60px;">
                </a>

                <!-- Links Desktop (Escondidos no Celular com d-none d-lg-flex) -->
                <div class="d-none d-lg-flex align-items-center">
                    <a class="nav-link mx-2" asp-controller="Home" asp-action="Index">Início</a>
                    <a class="nav-link mx-2" href="#">Promoções</a>
                    <a class="nav-link mx-2" asp-controller="Carrinho" asp-action="Index">Carrinho</a>
                    <a class="nav-link mx-2" asp-controller="Pedido" asp-action="MeusPedidos">Meus Pedidos</a>

                    <!-- MENU RESTRITO PARA ADMIN -->
                    @if (Context.Session.GetString("Perfil") == "Admin")
                    {
                        <a class="nav-link fw-bold text-danger mx-2" asp-controller="Pedido" asp-action="GerenciarPedidos">⚙️ Pedidos</a>
                        <a class="nav-link fw-bold text-danger mx-2" asp-controller="Produto" asp-action="Index">⚙️ Produtos</a>
                    }

                    <!-- Botões de Login (Desktop) -->
                    <div class="ms-4 border-start ps-4">
                        <a class="btn btn-outline-dark me-2" asp-controller="Cliente" asp-action="Login">Entrar</a>
                        <a class="btn btn-primary" asp-controller="Cliente" asp-action="Cadastrar">Criar Conta</a>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <!-- MENU INFERIOR FIXO (Apenas Celular com d-flex d-lg-none) -->
    <nav class="navbar fixed-bottom bg-white border-top shadow-lg d-flex d-lg-none justify-content-around py-2" style="z-index: 1050;">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark text-center">
            <div class="fs-4">🏠</div>
            <small>Início</small>
        </a>
        <a asp-controller="Carrinho" asp-action="Index" class="text-decoration-none text-dark text-center">
            <div class="fs-4">🛒</div>
            <small>Carrinho</small>
        </a>
        <a asp-controller="Pedido" asp-action="MeusPedidos" class="text-decoration-none text-dark text-center">
            <div class="fs-4">📦</div>
            <small>Pedidos</small>
        </a>
        
        @if (Context.Session.GetString("Perfil") == "Admin")
        {
            <a asp-controller="Pedido" asp-action="GerenciarPedidos" class="text-decoration-none text-danger fw-bold text-center">
                <div class="fs-4">⚙️</div>
                <small>Admin</small>
            </a>
        }
        else
        {
            <a asp-controller="Cliente" asp-action="Login" class="text-decoration-none text-dark text-center">
                <div class="fs-4">👤</div>
                <small>Perfil</small>
            </a>
        }
    </nav>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="container mt-4 pb-5">
        @RenderBody()
    </main>

    <footer class="text-center mt-5 mb-4">
        <p class="text-muted">
            <small>© 2026 - Douglas Heinrick de Souza Cunha - Thiago Elson Alves Matos</small>
        </p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
