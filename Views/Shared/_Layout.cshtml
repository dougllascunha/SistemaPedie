<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pediê</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/imagens/LogoPedie.png"
                    alt="Pediê"
                    class="logo-navbar fotologo">
                </a>

                <div>
                    <a class="nav-link d-inline"
                       asp-controller="Home"
                       asp-action="Index">
                        Início
                    </a>

                    <a class="nav-link d-inline"
                       href="#">
                        Promoções
                    </a>

                    <a class="nav-link d-inline"
                       asp-controller="Carrinho"
                       asp-action="Index">
                        Carrinho
                    </a>

                    <a class="nav-link d-inline"
                       asp-controller="Pedido"
                       asp-action="MeusPedidos">
                        Meus Pedidos
                    </a>

                    @if (Context.Session.GetString("Perfil") == "Admin")
                    {
                        <a class="nav-link d-inline fw-bold text-danger ms-3" asp-controller="Pedido" asp-action="GerenciarPedidos">
                            ⚙️ Gestão de Pedidos
                        </a>
                        <a class="nav-link d-inline fw-bold text-danger ms-2" asp-controller="Produto" asp-action="Index">
                            ⚙️ Gestão de Produtos
                        </a>
                    }

                    <a class="nav-link d-inline fw-bold ms-3"
                       asp-controller="Cliente"
                       asp-action="Login">
                        Entrar
                    </a>

                    <a class="nav-link d-inline fw-bold text-primary ms-2"
                       asp-controller="Cliente"
                       asp-action="Cadastrar">
                        Criar Conta
                    </a>
                </div>
                </div>

            </div>
        </nav>
    </header>

    

        <main class="container">
            @RenderBody()
        </main>

    

    <footer class="text-center mt-5 mb-3">
        <p>
            © 2026 - Douglas Heinrick de Souza Cunha - Thiago Elson Alves Matos
        </p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    
</body>

</html>
